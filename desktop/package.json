{
  "name": "hive-desktop",
  "productName": "Tensai",
  "version": "1.0.0",
  "description": "Tensai AI agent studio for your desktop",
  "main": "main.cjs",
  "author": "Tensai",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.tensai.desktop",
    "productName": "Tensai",
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "server", "to": "server" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.png", "artifactName": "Tensai-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
